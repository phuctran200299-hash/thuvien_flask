# Sao chép file này thành .env rồi sửa theo máy của bạn

# Chuỗi bí mật để ký session/CSRF - đổi thành chuỗi ngẫu nhiên dài khi triển khai
SECRET_KEY=doi-chuoi-nay

# Kết nối SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=MatKhauCuaBan
DB_NAME=library_management

# Hoặc khai báo trực tiếp 1 chuỗi kết nối SQLAlchemy (ưu tiên hơn các biến trên)
# DATABASE_URL=mssql+pymssql://sa:MatKhau@localhost:1433/library_management?charset=utf8

# Trợ lý AI hỏi đáp (Claude API) - lấy API key tại https://platform.claude.com
# Để trống: trợ lý vẫn chạy ở chế độ trả lời tự động từ CSDL (miễn phí)
ANTHROPIC_API_KEY=
# Model: claude-haiku-5-5 (mặc định, rẻ) hoặc claude-opus-5-5 (tốt hơn, đắt hơn)
# CHATBOT_MODEL=claude-haiku-5-5
# Tắt trợ lý: CHATBOT_ENABLED=0
# CHATBOT_ENABLED=1
